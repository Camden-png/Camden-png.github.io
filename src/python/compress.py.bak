import glob
import os
import shutil
import subprocess

from PIL import Image, ImageSequence

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
ROOT_DIR = os.path.dirname(os.path.dirname(SCRIPT_DIR))
INPUT_DIR = os.path.join(os.path.dirname(SCRIPT_DIR), "static")
OUTPUT_DIR = os.path.join(ROOT_DIR, "docs", "static")

# Check if `gifsicle` is available...
HAS_GIFSICLE = False
try:
    subprocess.run(["gifsicle", "--version"], capture_output=True, check=True)
    print("* Has `gifsicle`...")
    HAS_GIFSICLE = True
except (subprocess.CalledProcessError, FileNotFoundError):
    pass

PNG = ".png"
GIF = ".gif"

COMPRESS_LEVEL = 9
GIF_COLORS = 32
GIF_COLOR_OVERRIDES = {
    "OOPs.gif": 128,
    "Lingo.gif": 80,
    "Boba.gif": 80
}

# Scale and drop frames for large GIFs
LARGE_GIF_THRESHOLD = 500 * 1024  # 500 KB
SCALE_FACTOR = 0.75

FRAME_SKIP = 2  # Keep every other frame
NO_FRAME_SKIP = ["Boba.gif"]

# Palette GIFs that should just be copied (avoid PIL palette issues)
PALETTE_COPY_ONLY = ["Talk.gif", "Eat.gif"]


def _compress_gif(input_path: str, output_path: str, colors: int) -> None:
    file_size = os.path.getsize(input_path)
    file_name = os.path.basename(input_path)

    # Some palette GIFs have PIL compatibility issues - just copy and optimize
    if file_name in PALETTE_COPY_ONLY:
        shutil.copy2(input_path, output_path)
        if HAS_GIFSICLE:
            try:
                subprocess.run(
                    ["gifsicle", "--optimize=3", "-o", output_path, output_path],
                    check=True,
                    capture_output=True
                )
            except subprocess.CalledProcessError:
                pass
        return

    with Image.open(input_path) as gif:
        # Check transparency on the GIF itself or its first frame
        first_frame = next(ImageSequence.Iterator(gif))
        has_transparency = (
            "transparency" in gif.info
            or "transparency" in first_frame.info
            or gif.mode == "RGBA"
        )
        gif.seek(0)

        # For palette GIFs, preserve the original palette
        is_palette = gif.mode == "P"
        is_palette_transparent = is_palette and has_transparency
        palette_image = gif.copy() if is_palette else None

        # Scale/skip frames for large GIFs, except transparent palette ones
        is_large = file_size > LARGE_GIF_THRESHOLD and not is_palette_transparent
        
        # Scale palette reference if needed
        if is_large and is_palette and palette_image:
            new_size = (int(palette_image.width * SCALE_FACTOR), int(palette_image.height * SCALE_FACTOR))
            palette_image = palette_image.resize(new_size, Image.Resampling.LANCZOS)

        frames = []
        durations = []

        for frame_idx, frame in enumerate(ImageSequence.Iterator(gif)):
            should_skip_frame = is_large and file_name not in NO_FRAME_SKIP and frame_idx % FRAME_SKIP != 0
            if should_skip_frame:
                continue

            duration = frame.info.get("duration", gif.info.get("duration", 100))
            if is_large and file_name not in NO_FRAME_SKIP:
                duration *= FRAME_SKIP

            durations.append(duration)

            # Scale down for large GIFs
            if is_large:
                new_size = (int(frame.width * SCALE_FACTOR), int(frame.height * SCALE_FACTOR))
                frame = frame.resize(new_size, Image.Resampling.LANCZOS)

            if is_palette:
                # Keep palette mode - composite and quantize back with original palette
                rgb = frame.convert("RGB")
                p_frame = rgb.quantize(palette=palette_image)
                frames.append(p_frame)

            elif has_transparency:
                # RGBA mode transparent GIF - quantize
                rgba = frame.convert("RGBA")
                quantized = rgba.quantize(
                    colors=colors,
                    method=Image.Quantize.FASTOCTREE
                )
                frames.append(quantized)

            else:
                # Non-transparent - quantize with dithering
                rgb = frame.convert("RGB")
                quantized = rgb.quantize(
                    colors=colors,
                    method=Image.Quantize.MEDIANCUT,
                    dither=Image.Dither.FLOYDSTEINBERG
                )
                frames.append(quantized)

        save_kwargs = {
            "optimize": not is_palette,  # Disable for palette GIFs - gifsicle will handle it
            "save_all": True,
            "append_images": frames[1:],
            "duration": durations,
            "loop": gif.info.get("loop", 0)
        }

        if has_transparency:
            if is_palette:
                # Use original transparency index for palette GIFs
                save_kwargs["transparency"] = gif.info.get("transparency", 0)
            else:
                # Find transparent index by checking where alpha was 0
                gif.seek(0)

                rgba_check = gif.convert("RGBA")
                alpha = rgba_check.split()[3]
                trans_index = 0

                found = False
                for y in range(alpha.size[1]):
                    for x in range(alpha.size[0]):
                        if alpha.getpixel((x, y)) == 0:
                            trans_index = frames[0].getpixel((x, y))
                            found = True
                            break
                    if found:
                        break
                save_kwargs["transparency"] = trans_index

            save_kwargs["disposal"] = 2

        frames[0].save(output_path, **save_kwargs)

        # Post-process with `gifsicle` if available...
        if not HAS_GIFSICLE:
            return

        # Use lossless optimization for palette GIFs to preserve colors
        # Use lossy for quantized RGB GIFs
        gifsicle_args = ["gifsicle", "--optimize=3"]
        if not is_palette:
            gifsicle_args.append("--lossy=80")
        gifsicle_args += ["-o", output_path, output_path]

        try:
            subprocess.run(gifsicle_args, check=True, capture_output=True)
        except subprocess.CalledProcessError:
            pass


def _compress_png(input_path: str, output_path: str) -> None:
    with Image.open(input_path) as image:
        if image.mode in ["RGBA", "LA", "PA"]:
            clean = image.convert("RGBA")
        elif image.mode == "P" and "transparency" in image.info:
            clean = image.convert("RGBA")
        else:
            clean = image.convert("RGB")

        clean.save(
            output_path,
            optimize=True,
            compress_level=COMPRESS_LEVEL
        )


def main() -> None:
    file_paths = (
        glob.glob(os.path.join(INPUT_DIR, "**", "*.png"), recursive=True) +
        glob.glob(os.path.join(INPUT_DIR, "**", "*.gif"), recursive=True)
    )

    total_before = 0
    total_after = 0

    for input_path in file_paths:
        relative_path = os.path.relpath(input_path, INPUT_DIR)
        output_path = os.path.join(OUTPUT_DIR, relative_path)

        ext = os.path.splitext(input_path)[1].lower()

        if ext not in [PNG, GIF]:
            raise NotImplementedError(f"`{ext.upper()}` is not supported!")

        os.makedirs(os.path.dirname(output_path), exist_ok=True)

        before_size = os.path.getsize(input_path)

        if ext == PNG:
            _compress_png(input_path, output_path)
        elif ext == GIF:
            file_name = os.path.basename(input_path)
            colors = GIF_COLOR_OVERRIDES.get(file_name, GIF_COLORS)
            _compress_gif(input_path, output_path, colors)

        after_size = os.path.getsize(output_path)

        if after_size >= before_size:
            shutil.copy(input_path, output_path)
            after_size = before_size
            result = "kept original"
        else:
            change = (before_size - after_size) / before_size
            result = f"{change:.1%} smaller"

        total_before += before_size
        total_after += after_size

        print(
            f"* {os.path.basename(output_path)}: "
            f"{before_size / 1024:.1f} KB -> "
            f"{after_size / 1024:.1f} KB "
            f"({result})"
        )

    total_saved = (total_before - total_after) / total_before if total_before else 0
    print(
        f"Total: {total_before / 1024 / 1024:.2f} MB -> "
        f"{total_after / 1024 / 1024:.2f} MB "
        f"({total_saved:.1%} saved)"
    )


if __name__ == "__main__":
    main()
